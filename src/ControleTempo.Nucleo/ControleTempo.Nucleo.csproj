<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ControleTempo.Nucleo
    ====================
    Host principal do sistema. Reúne, em um único processo:
      - o motor de contagem (ControleTempo.Core), rodando como worker em segundo plano;
      - o servidor web Kestrel que serve o painel administrativo remoto;
      - a API local consumida pelo overlay (na sessão do usuário) e pela ferramenta
        de recuperação.
    Projetado para rodar como Serviço do Windows (AddWindowsService), iniciando no
    boot e como conta de sistema. Mantém-se em net8.0 (sem WPF) para que a lógica e
    o painel possam ser compilados/testados em qualquer plataforma; as chamadas
    específicas do Windows são protegidas por verificação em tempo de execução.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ControleTempo.Nucleo</RootNamespace>
    <AssemblyName>ControleTempo.Nucleo</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControleTempo.Core\ControleTempo.Core.csproj" />
  </ItemGroup>

</Project>
